#! pkg: purrr
#! tier: T1
#! since: 1.2.2
#! note: marshalling automatique via @extern — to_native() dépouille l'enveloppe TypR (typed_vec) avant l'appel
#! param x: liste ou vecteur, typé ou non
#! ret: TRUE si `x` a longueur 0
#! example: is_empty([])   # -> TRUE
@extern purrr::is_empty: (x: Any) -> bool;

#! pkg: purrr
#! tier: T1
#! since: 1.2.2
#! note: marshalling automatique via @extern
#! param x: valeur quelconque à tester
#! ret: TRUE si `x` est une fonction
#! example: is_function([1, 2, 3])   # -> FALSE
@extern purrr::is_function: (x: Any) -> bool;
